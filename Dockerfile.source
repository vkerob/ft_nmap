FROM alpine:latest

RUN apk update && apk upgrade musl && apk add --no-cache \
		gdb valgrind \
    # build tools
    gcc g++ make cmake musl-dev linux-headers \
    # network libs
    libpcap-dev \
    # regex lib used by the test suite
    pcre2-dev \
    # shells & editors
    bash vim \
    # network debug & sniffing
    tcpdump \
    net-tools \
    iproute2 \
    iputils \
    ethtool \
    nmap \
    # connectivity
    curl wget \
    netcat-openbsd \
    socat \
    bind-tools \
    iperf3 \
    # process & system debug
    strace \
    lsof \
    procps \
    htop

WORKDIR /app

CMD ["tail", "-f", "/dev/null"]
